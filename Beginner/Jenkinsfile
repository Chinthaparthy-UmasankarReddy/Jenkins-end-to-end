podTemplate(name: 'ci-pod', namespace: 'jenkins', label: 'ci-pod', containers: [
    // 1. Maven container for building and compiling code
    containerTemplate(name: 'maven', image: 'maven:3.9-eclipse-temurin-17', ttyEnabled: true, command: 'sleep', args: '99d'),
    
    // 2. Trivy container for vulnerability scanning of container images
    containerTemplate(name: 'trivy', image: 'aquasec/trivy:latest', ttyEnabled: true, command: 'sleep', args: '99d'),
    
    // 3. Docker CLI container for building images via host socket sharing
    containerTemplate(name: 'docker', image: 'docker:cli', ttyEnabled: true, command: 'sleep', args: '99d')
], volumes: [
    // Mounts the Docker Desktop host socket so the docker container can build images locally
    hostPathVolume(mountPath: '/var/run/docker.sock', hostPath: '/var/run/docker.sock')
]) {
    pipeline {
        agent { label 'ci-pod' }
        stages {
            stage('Test Pod Setup') {
                steps {
                    container('maven') {
                        sh 'mvn --version'
                    }
                    container('docker') {
                        sh 'docker --version'
                    }
                    container('trivy') {
                        sh 'trivy --version'
                    }
                }
            }
        }
    }
}